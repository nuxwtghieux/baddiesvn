local FIX = Vector3.new(563.2, 3.9, -20.8)
local FIX_STAND = Vector3.new(FIX.X + 3, FIX.Y, FIX.Z)
local RAD = 50
local FLY_SPEED = 200
local HEAD_OFFSET = 8
local MAX_SPEED = 18
local STUCK_TIMEOUT = 10
local HIT_RANGE = 4
local STOMP_RANGE = 1.5
local HP_THRESHOLD = 3

local act = false
local stb = false
local atk = false
local noc = false
local Y = nil
local En = false
local Tar = nil
local isMoving = false
local moveTask = nil

local function getMobileStompButton()
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v.Name == "Stomp" and v.Parent and v.Parent.Name == "MobileButtons" then
            if v:IsA("TextButton") or v:IsA("ImageButton") then
                return v
            end
        end
    end
    return nil
end

local function clickButton(btn)
    if not btn then return false end
    pcall(function()
        btn:FireEvent("MouseButton1Click")
        btn:Activate()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        if pos.X > 0 and pos.Y > 0 then
            local x = pos.X + size.X / 2
            local y = pos.Y + size.Y / 2
            if btn.InputBegan then
                btn.InputBegan:Fire({
                    UserInputType = Enum.UserInputType.MouseButton1,
                    Position = Vector2.new(x, y)
                })
            end
        end
    end)
    return true
end

local function pressKey(key)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(0.01)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
end

local function get()
    local c = player.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function equipFist()
    local c = player.Character
    if not c then return false end
    local h = c:FindFirstChild("Humanoid")
    if not h then return false end
    for _, v in pairs(c:GetChildren()) do
        if v:IsA("Tool") and v.Name == "Fist" then
            return true
        end
    end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        local fist = bp:FindFirstChild("Fist")
        if fist then
            h:EquipTool(fist)
            task.wait(0.02)
            return true
        end
    end
    return false
end

local function doHit()
    equipFist()
    local c = player.Character
    if c then
        local fist = c:FindFirstChild("Fist")
        if fist and fist:IsA("Tool") then
            pcall(function() fist:Activate() end)
        end
    end
end

local function doGrab()
    pressKey(Enum.KeyCode.G)
end

local function doStomp()
    pressKey(Enum.KeyCode.E)
    local btn = getMobileStompButton()
    if btn then clickButton(btn) end
    doHit()
end

local function enableNoclip(c)
    noc = true
    if not c then return end
    for _, v in pairs(c:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
end

local function disableNoclip(c)
    noc = false
    if not c then return end
    for _, v in pairs(c:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = true end
    end
end

local function enableFreefall(h)
    h.PlatformStand = true
    workspace.Gravity = 0
end

local function disableFreefall(h, r)
    h.PlatformStand = false
    h.AutoRotate = true
    workspace.Gravity = 196.2
    if r then r.Velocity = Vector3.zero end
    h.WalkSpeed = MAX_SPEED
end

local function flyToFix()
    if not act then return end
    stb = false
    En = true
    local c, h, r = get()
    if not r or not h then return end
    local tg = FIX_STAND
    Y = tg.Y - HEAD_OFFSET
    enableFreefall(h)
    enableNoclip(c)
    r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
    r.Velocity = Vector3.zero
    local lastPos = r.Position
    local stuckTime = 0
    while act and En and r and r.Parent do
        local flatCur = Vector3.new(r.Position.X, 0, r.Position.Z)
        local flatTgt = Vector3.new(tg.X, 0, tg.Z)
        if (flatCur - flatTgt).Magnitude <= 5 then break end
        local dir = (flatTgt - flatCur).Unit
        r.Velocity = Vector3.new(dir.X * FLY_SPEED, 0, dir.Z * FLY_SPEED)
        if math.abs(r.Position.Y - Y) > 0.5 then
            r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
        end
        h.AutoRotate = false
        if dir.Magnitude > 0.01 then
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(r.Position.X + dir.X, r.Position.Y, r.Position.Z + dir.Z))
        end
        if (r.Position - lastPos).Magnitude < 0.5 then
            stuckTime = stuckTime + 0.1
            if stuckTime >= STUCK_TIMEOUT then break end
        else
            stuckTime = 0
        end
        lastPos = r.Position
        task.wait()
    end
    En = false
    r.Velocity = Vector3.zero
    if r and r.Parent then
        disableFreefall(h, r)
        task.wait(0.1)
        local startY = r.Position.Y
        local targetY = tg.Y
        for t = 0, 1, 0.05 do
            if not act or not r or not r.Parent then break end
            local newY = startY + (targetY - startY) * t
            r.CFrame = CFrame.new(r.Position.X, newY, r.Position.Z)
            r.Velocity = Vector3.zero
            task.wait(0.02)
        end
        r.CFrame = CFrame.new(tg.X, tg.Y, tg.Z)
        r.Velocity = Vector3.zero
        task.wait(0.2)
    end
    disableNoclip(c)
    h.WalkSpeed = MAX_SPEED
    Y = nil
    stb = true
end

local function moveToTarget(tr)
    if moveTask then task.cancel(moveTask) end
    isMoving = true
    moveTask = task.spawn(function()
        local _, h, r = get()
        if not h or not r then isMoving = false return end
        h.WalkSpeed = MAX_SPEED
        while act and stb and isMoving and r and r.Parent and tr and tr.Parent do
            if not Tar or not Tar.Character then break end
            local tr2 = Tar.Character:FindFirstChild("HumanoidRootPart")
            if not tr2 then break end
            if (FIX - tr2.Position).Magnitude > RAD then break end
            local dist = (r.Position - tr2.Position).Magnitude
            if dist <= HIT_RANGE then break end
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(tr2.Position.X, r.Position.Y, tr2.Position.Z))
            h:MoveTo(tr2.Position)
            task.wait(0.05)
        end
        isMoving = false
        moveTask = nil
    end)
end

local function moveToStompRange(tr)
    if moveTask then task.cancel(moveTask) end
    isMoving = true
    moveTask = task.spawn(function()
        local _, h, r = get()
        if not h or not r then isMoving = false return end
        h.WalkSpeed = MAX_SPEED
        while act and stb and isMoving and r and r.Parent and tr and tr.Parent do
            if not Tar or not Tar.Character then break end
            local tr2 = Tar.Character:FindFirstChild("HumanoidRootPart")
            if not tr2 then break end
            if (FIX - tr2.Position).Magnitude > RAD then break end
            local dist = (r.Position - tr2.Position).Magnitude
            if dist <= STOMP_RANGE then break end
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(tr2.Position.X, r.Position.Y, tr2.Position.Z))
            h:MoveTo(tr2.Position)
            task.wait(0.05)
        end
        isMoving = false
        moveTask = nil
    end)
end

local function stopMoving()
    isMoving = false
    if moveTask then
        task.cancel(moveTask)
        moveTask = nil
    end
end

task.spawn(function()
    while true do
        task.wait(0.03)
        
        if not act or not stb then
            stopMoving()
            atk = false
            continue
        end
        
        if not Tar then
            stopMoving()
            atk = false
            continue
        end
        
        local tc = Tar.Character
        if not tc then
            stopMoving()
            atk = false
            continue
        end
        
        local tr = tc:FindFirstChild("HumanoidRootPart")
        local th = tc:FindFirstChild("Humanoid")
        
        if not tr or not th or th.Health <= 0 then
            stopMoving()
            atk = false
            continue
        end
        
        if (FIX - tr.Position).Magnitude > RAD then
            stopMoving()
            atk = false
            continue
        end
        
        local _, _, r = get()
        if not r then
            atk = false
            continue
        end
        
        local dist = (r.Position - tr.Position).Magnitude
        
        -- MÁU < 3: TIẾN SÁT 1.5 STUD ĐỂ STOMP + HIT
        if th.Health < HP_THRESHOLD then
            if dist > STOMP_RANGE then
                atk = true
                if not isMoving then
                    moveToStompRange(tr)
                end
            else
                stopMoving()
                atk = true
                r.CFrame = CFrame.lookAt(r.Position, Vector3.new(tr.Position.X, r.Position.Y, tr.Position.Z))
                equipFist()
                doStomp()
                task.wait(0.02)
            end
        -- MÁU >= 3: HIT + GRAB
        else
            if dist > HIT_RANGE then
                atk = true
                if not isMoving then
                    moveToTarget(tr)
                end
            else
                stopMoving()
                atk = true
                r.CFrame = CFrame.lookAt(r.Position, Vector3.new(tr.Position.X, r.Position.Y, tr.Position.Z))
                equipFist()
                doHit()
                doGrab()
                task.wait(0.02)
            end
        end
    end
end)

player.CharacterAdded:Connect(function()

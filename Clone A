    for _, pl in pairs(P:GetPlayers()) do
        if pl ~= p then
            local b = Instance.new("TextButton", sf) b.Size = UDim2.new(1, -6, 0, 24) b.BackgroundColor3 = (Tar == pl) and Color3.fromRGB(120, 0, 150) or Color3.fromRGB(35, 35, 40) b.Text, b.TextColor3, b.Font, b.TextSize, b.TextXAlignment = "  " .. pl.DisplayName, Color3.new(1, 1, 1), Enum.Font.Gotham, 11, Enum.TextXAlignment.Left Instance.new("UICorner", b)

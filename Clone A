local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local EventRemote = ReplicatedStorage:WaitForChild("Event")

-- CẤU HÌNH DI CHUYỂN SIÊU TỐC
local FLY_SPEED = 400
local WALK_SPEED = 32
local HEAD_OFFSET = 12 
local FIXED_POS = Vector3.new(563.2, 3.9, -20.8)
local RAD = 40

-- TRẠNG THÁI HỆ THỐNG
local act = false
local stb = false
local atk = false
local noc = false
local Y = nil
local En = false
local Tar = nil

local function getChar()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    return char, hum, hrp
end

local function setNoc(char, state)
    noc = state
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = not state end
    end
end

-- GHIM NOCLIP LIÊN TỤC MỖI KHUNG HÌNH KHI ĐANG BAY CHỐNG KẸT ĐẤT
RunService.Heartbeat:Connect(function()
    if not En or not act then return end 
    local c, _, _ = getChar()
    if noc and c then 
        setNoc(c, true) -- Liên tục đè CanCollide = false chống game tự bật lại
    end 
end)

-- Hàm bay ngầm chuẩn đích Vector3 3D
local function fly(tg)
    if not act then return end 
    stb = false
    En = true 
    local c, h, r = getChar()
    if not r or not h then return end
    
    Y = tg.Y - HEAD_OFFSET 
    setNoc(c, true)
    h.PlatformStand = true
    workspace.Gravity = 0
    
    -- Hạ độ cao xuống lòng đất ngay vị trí hiện tại trước khi bay ngang
    r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
    r.Velocity = Vector3.zero
    task.wait(0.1)
    
    -- Giai đoạn 1: Bay ngang dưới lòng đất
    while En and r and r.Parent and act do 
        local currentUndergroundPos = Vector3.new(r.Position.X, Y, r.Position.Z)
        local targetUndergroundPos = Vector3.new(tg.X, Y, tg.Z)
        local d = (currentUndergroundPos - targetUndergroundPos).Magnitude 
        
        if d <= 4 then break end
        
        local dir = (targetUndergroundPos - currentUndergroundPos).Unit 
        r.Velocity = Vector3.new(dir.X * FLY_SPEED, 0, dir.Z * FLY_SPEED)
        
        if math.abs(r.Position.Y - Y) > 0.5 then 
            r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z) 
        end 
        task.wait()
    end
    
    -- Giai đoạn 2: Trồi thẳng đứng lên mặt đất (vẫn được bảo vệ bởi Heartbeat Noclip)
    local upTargetY = tg.Y + 3 -- Nhô cao hơn mặt đất hẳn 3 studs để an toàn
    while En and r and r.Parent and act do
        if r.Position.Y >= upTargetY then break end
        r.Velocity = Vector3.new(0, 50, 0) 
        task.wait()
    end
    
    En = false
    
    -- Giai đoạn 3: Khóa ổn định vật lý trên không rồi thả rụng tiếp đất
    if r then 
        r.Velocity = Vector3.zero 
        r.CFrame = CFrame.new(tg)
        r.Anchored = true 
    end
    task.wait(0.15)
    
    if r then r.Anchored = false end 
    if h then h.PlatformStand = false h.AutoRotate = true h.WalkSpeed = WALK_SPEED end
    workspace.Gravity = 196.2 
    setNoc(c, false) -- Tiếp đất an toàn mới bật lại va chạm bình thường
    stb = true 
end

local function checkTargetInZone()
    if not act or not stb or not Tar or not Tar.Character then return false end 
    local tr = Tar.Character:FindFirstChild("HumanoidRootPart")
    local th = Tar.Character:FindFirstChild("Humanoid")
    if tr and th and th.Health > 0 then 
        return (FIXED_POS - tr.Position).Magnitude <= RAD 
    end 
    return false 
end

task.spawn(function()
    while true do 
        task.wait(0.02)
        if act and stb and checkTargetInZone() then 
            local c, h, r = getChar()
            local tc = Tar.Character
            local tr = tc and tc:FindFirstChild("HumanoidRootPart")
            local th = tc and tc:FindFirstChild("Humanoid")
            
            if r and h and tr and th and th.Health > 0 then 
                h.WalkSpeed = WALK_SPEED
                atk = true 
                r.CFrame = CFrame.new(tr.Position + Vector3.new(0, 2.5, 0), tr.Position)
                
                if th.Health > 2 then 
                    EventRemote:FireServer({ = {["Event"] = "Hit", ["ClientHitbox"] = {}}})
                else 
                    EventRemote:FireServer({ = {["Event"] = "Stomp"}})
                    EventRemote:FireServer({ = {["Event"] = "Stomp"}})
                    EventRemote:FireServer({ = {["Event"] = "Hit", ["ClientHitbox"] = {}}})
                    EventRemote:FireServer({ = {["Event"] = "Hit", ["ClientHitbox"] = {}}})
                end 
            end
        else 
            if atk or not act then 
                atk = false 
                local _, h, _ = getChar()
                if h and act then 
                    h.WalkSpeed = WALK_SPEED
                    h:MoveTo(FIXED_POS)
                end 
            end 
        end 
    end 
end)

player.CharacterAdded:Connect(function()
    if act then task.wait(1) fly(FIXED_POS) end
end)


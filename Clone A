local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local EventRemote = ReplicatedStorage:WaitForChild("Event")

-- CẤU HÌNH DI CHUYỂN SIÊU NHANH
local FLY_SPEED = 400 -- Tốc độ bay ngầm dưới lòng đất (Đã tăng tốc)
local WALK_SPEED = 32  -- Tốc độ đi bộ áp sát mục tiêu (Đã tăng tốc)
local HEAD_OFFSET = 12 
local FIXED_POS = Vector3.new(563.2, 3.9, -20.8)
local RAD = 40

-- TRẠNG THÁI HỆ THỐNG
local act = false
local stb = false
local atk = false
local noc = false
local Y = nil
local En = false
local Tar = nil

-- Hàm lấy thông tin nhân vật an toàn
local function getChar()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    return char, hum, hrp
end

-- Bật/tắt noclip an toàn chống ban
local function setNoc(char, state)
    noc = state
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then 
            v.CanCollide = not state 
        end
    end
end

-- Hàm thực thi bay ngầm tốc độ cao
local function fly(tg)
    if not act then return end 
    stb = false
    En = true 
    local c, h, r = getChar()
    if not r or not h then return end
    
    Y = tg.Y - HEAD_OFFSET 
    setNoc(c, true)
    h.PlatformStand = true
    workspace.Gravity = 0
    r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
    r.Velocity = Vector3.zero
    
    while En and r and r.Parent and act do 
        local d = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(tg.X, 0, tg.Z)).Magnitude 
        if d <= 3 then break end
        
        local dir = (Vector3.new(tg.X, 0, tg.Z) - Vector3.new(r.Position.X, 0, r.Position.Z)).Unit 
        r.Velocity = Vector3.new(dir.X * FLY_SPEED, 0, dir.Z * FLY_SPEED)
        
        if math.abs(r.Position.Y - Y) > 0.5 then 
            r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z) 
        end 
        
        h.AutoRotate = false 
        if dir.Magnitude > 0.01 then 
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(r.Position.X + dir.X, r.Position.Y, r.Position.Z + dir.Z)) 
        end 
        task.wait()
    end
    
    En = false
    if r then r.Velocity = Vector3.zero r.CFrame = CFrame.new(tg) end
    task.wait(0.2)
    if h then h.PlatformStand = false h.AutoRotate = true h.WalkSpeed = WALK_SPEED end
    workspace.Gravity = 196.2 
    setNoc(c, false)
    stb = true 
end

-- Giữ trạng thái bay ngầm bằng Heartbeat
RunService.Heartbeat:Connect(function()
    if not En or not act then return end 
    local c, _, r = getChar()
    if noc and c then setNoc(c, true) end 
    if r and Y and math.abs(r.Position.Y - Y) > 2 then 
        r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
        r.Velocity = Vector3.new(r.Velocity.X, 0, r.Velocity.Z)
    end 
end)

-- Kiểm tra mục tiêu lọt vào zone
local function checkTargetInZone()
    if not act or not stb or not Tar or not Tar.Character then return false end 
    local tr = Tar.Character:FindFirstChild("HumanoidRootPart")
    local th = Tar.Character:FindFirstChild("Humanoid")
    if tr and th and th.Health > 0 then 
        return (FIXED_POS - tr.Position).Magnitude <= RAD 
    end 
    return false 
end

-- Vòng lặp đè đầu đánh và combo kết liễu
task.spawn(function()
    while true do 
        task.wait(0.02)
        if act and stb and checkTargetInZone() then 
            local c, h, r = getChar()
            local tc = Tar.Character
            local tr = tc and tc:FindFirstChild("HumanoidRootPart")
            local th = tc and tc:FindFirstChild("Humanoid")
            
            if r and h and tr and th and th.Health > 0 then 
                h.WalkSpeed = WALK_SPEED
                atk = true 
                r.CFrame = CFrame.new(tr.Position + Vector3.new(0, 2.5, 0), tr.Position)
                
                if th.Health > 2 then 
                    EventRemote:FireServer({[1] = {["Event"] = "Hit", ["ClientHitbox"] = {}}})
                else 
                    EventRemote:FireServer({[1] = {["Event"] = "Stomp"}})
                    EventRemote:FireServer({[1] = {["Event"] = "Stomp"}})
                    EventRemote:FireServer({[1] = {["Event"] = "Hit", ["ClientHitbox"] = {}}})
                    EventRemote:FireServer({[1] = {["Event"] = "Hit", ["ClientHitbox"] = {}}})
                end 
            end
        else 
            if atk or not act then 
                atk = false 
                local _, h, _ = getChar()
                if h and act then 
                    h.WalkSpeed = WALK_SPEED
                    h:MoveTo(FIXED_POS)
                end 
            end 
        end 
    end 
end)

player.CharacterAdded:Connect(function()
    if act then 
        task.wait(1) 
        fly(FIXED_POS) 
    end 
end)


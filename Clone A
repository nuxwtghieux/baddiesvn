-- Logic nút bấm điều khiển
btn.MouseButton1Click:Connect(function()
    if not act then
        act = true
        btn.Text = "🛑 STOP SYSTEM"
        btn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
        task.spawn(function() fly(FIXED_POS) end)
    else
        act = false
        stb = false
        En = false
        atk = false
        btn.Text = "▶ START INJECT"
        btn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
        local _, h, r = getChar()
        if h and r then h:MoveTo(r.Position) end
    end
end)

-- Cập nhật danh sách người chơi
local function up()
    for _, v in pairs(sf:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    for _, pl in pairs(Players:GetPlayers()) do
        if pl ~= player then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -6, 0, 24)
            b.BackgroundColor3 = (Tar == pl) and Color3.fromRGB(120, 0, 150) or Color3.fromRGB(35, 35, 40)
            b.Text = "  " .. pl.DisplayName
            b.TextColor3 = Color3.new(1, 1, 1)
            b.Font = Enum.Font.Gotham
            b.TextSize = 11
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.Parent = sf
            Instance.new("UICorner", b)
            
            b.MouseButton1Click:Connect(function()
                Tar = pl
                up()
            end)
        end
    end
    sf.CanvasSize = UDim2.new(0, 0, 0, ll.AbsoluteContentSize.Y + 5)
end

Players.PlayerAdded:Connect(up)
Players.PlayerRemoving:Connect(function(pl)
    if Tar == pl then Tar = nil end
    up()
end)
up()

-- Vòng lặp cập nhật chữ trạng thái
task.spawn(function()

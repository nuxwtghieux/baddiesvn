local function refreshPlayerList()
    for _, v in pairs(scrollFrame:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
    local players = Players:GetPlayers()
    local count = 0
    for _, plr in pairs(players) do
        if plr ~= player then
            count = count + 1
            local pf = Instance.new("Frame")
            pf.Size = UDim2.new(1, -6, 0, 34)
            pf.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            pf.BorderSizePixel = 0
            pf.Parent = scrollFrame
            Instance.new("UICorner", pf).CornerRadius = UDim.new(0, 6)
            if TargetPlayer == plr then
                local s = Instance.new("UIStroke", pf)
                s.Color = Color3.fromRGB(0, 255, 100)
                s.Thickness = 1
            end
            local nl = Instance.new("TextLabel")
            nl.Size = UDim2.new(0, 140, 1, 0)
            nl.Position = UDim2.new(0, 6, 0, 0)
            nl.BackgroundTransparency = 1
            nl.Font = Enum.Font.GothamBold
            nl.TextColor3 = Color3.new(1, 1, 1)
            nl.TextSize = 11
            nl.Text = plr.Name
            nl.TextXAlignment = Enum.TextXAlignment.Left
            nl.TextTruncate = Enum.TextTruncate.AtEnd
            nl.Parent = pf
            local sb = Instance.new("TextButton")
            sb.Size = UDim2.new(0, 50, 0, 22)
            sb.Position = UDim2.new(1, -56, 0, 6)
            sb.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
            sb.Font = Enum.Font.GothamBold
            sb.TextColor3 = Color3.new(1, 1, 1)
            sb.TextSize = 10
            sb.Text = "CHON"
            sb.Parent = pf
            Instance.new("UICorner", sb).CornerRadius = UDim.new(0, 4)
            local pr = plr
            sb.MouseButton1Click:Connect(function()
                TargetPlayer = pr
                updateTargetInfo()
                refreshPlayerList()
            end)
        end
    end
    updateCanvasSize()
end


local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

pcall(function()
    local old = PlayerGui:FindFirstChild("CLONE_A_GUI")
    if old then old:Destroy() end
end)

local Remote = ReplicatedStorage:WaitForChild("Event")
local SPEED = 16
local FLY_SPEED = 200
local HEAD_OFFSET = 8
local NoclipOn = false
local UndergroundY = nil
local HOME_POS = Vector3.new(563.2, 3.9, -20.8)
local TargetPlayer = nil
local TargetHRP = nil
local TargetHumanoid = nil
local IsFighting = false
local IsReturning = false
local ScriptEnabled = false
local IsAtHome = false
local IsFlying = false
local SCAN_RANGE = 50

local function getChar()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    return char, hum, hrp
end

local function enableNoclip(char)
    NoclipOn = true
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
end

local function disableNoclip(char)
    NoclipOn = false
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = true end
    end
end

local function enableFreefall(hum)
    hum.PlatformStand = true
    workspace.Gravity = 0
end

local function disableFreefall(hum, hrp)
    hum.PlatformStand = false
    hum.AutoRotate = true
    workspace.Gravity = 196.2
    if hrp then hrp.Velocity = Vector3.zero end
    hum.WalkSpeed = SPEED
end

local function calculateUndergroundY(zoneY)
    return zoneY - HEAD_OFFSET
end

local function flyToTarget(targetPos, hum, hrp)
    IsFlying = true
    local lastPos = hrp.Position
    local stuckTime = 0
    enableFreefall(hum)
    enableNoclip(player.Character)
    local flyY = calculateUndergroundY(targetPos.Y)
    UndergroundY = flyY
    hrp.CFrame = CFrame.new(hrp.Position.X, flyY, hrp.Position.Z)
    hrp.Velocity = Vector3.zero
    while ScriptEnabled and IsFlying and hrp and hrp.Parent do
        local currentPos = hrp.Position
        local flatCurrent = Vector3.new(currentPos.X, 0, currentPos.Z)
        local flatTarget = Vector3.new(targetPos.X, 0, targetPos.Z)
        local dist = (flatCurrent - flatTarget).Magnitude
        if dist <= 5 then
            break
        end
        local direction = (flatTarget - flatCurrent).Unit
        hrp.Velocity = Vector3.new(direction.X * FLY_SPEED, 0, direction.Z * FLY_SPEED)
        if math.abs(hrp.Position.Y - flyY) > 0.5 then
            hrp.CFrame = CFrame.new(hrp.Position.X, flyY, hrp.Position.Z)
        end
        hum.AutoRotate = false
        if direction.Magnitude > 0.01 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(hrp.Position.X + direction.X, hrp.Position.Y, hrp.Position.Z + direction.Z))
        end
        if (hrp.Position - lastPos).Magnitude < 0.5 then
            stuckTime = stuckTime + 0.1
            if stuckTime >= 1.5 then
                break
            end
        else
            stuckTime = 0
        end
        lastPos = hrp.Position
        task.wait()
    end
    hrp.Velocity = Vector3.zero
    IsFlying = false
end

local function landSafely(targetPos, hum, hrp)
    if not hrp or not hrp.Parent then return end
    hrp.Velocity = Vector3.zero
    disableFreefall(hum, hrp)
    task.wait(0.1)
    hrp.CFrame = CFrame.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
    hrp.Velocity = Vector3.zero
    task.wait(0.2)
    disableNoclip(player.Character)
    hum.WalkSpeed = SPEED
    UndergroundY = nil
    IsFlying = false
end

local function goHome()
    IsReturning = true
    IsFighting = false
    IsAtHome = false
    IsFlying = false
    local char, hum, hrp = getChar()
    flyToTarget(HOME_POS, hum, hrp)
    landSafely(HOME_POS, hum, hrp)
    IsReturning = false
    IsAtHome = true
end

local function scanForTarget()
    if not IsAtHome then return nil end
    if IsFlying then return nil end
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    if TargetPlayer and TargetPlayer.Parent and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local targetHrp = TargetPlayer.Character.HumanoidRootPart
        local dist = (hrp.Position - targetHrp.Position).Magnitude
        if dist <= SCAN_RANGE then
            return TargetPlayer
        end
    end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            local targetHrp = plr.Character.HumanoidRootPart
            local targetHum = plr.Character.Humanoid
            if targetHum.Health > 0 then
                local dist = (hrp.Position - targetHrp.Position).Magnitude
                if dist <= SCAN_RANGE then
                    return plr
                end
            end
        end
    end
    return nil
end

local function faceTarget()
    if not TargetHRP or not TargetHRP.Parent then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then hum.AutoRotate = false end
    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(TargetHRP.Position.X, hrp.Position.Y, TargetHRP.Position.Z))
end

local function hitTarget()
    pcall(function()
        Remote:FireServer({["Event"] = "Hit", ["ClientHitbox"] = {}})
    end)
end

local function stompTarget()
    pcall(function()
        Remote:FireServer({["Event"] = "Stomp"})
    end)
end

local function standOnTarget()
    if not TargetHRP or not TargetHRP.Parent then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(TargetHRP.Position.X, TargetHRP.Position.Y + 2.5, TargetHRP.Position.Z)
    hrp.Velocity = Vector3.zero
end

local function fightLoop()
    while TargetPlayer and TargetPlayer.Parent and IsFighting and ScriptEnabled do
        if not TargetPlayer.Character or not TargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            task.wait(0.3)
            continue
        end
        TargetHRP = TargetPlayer.Character.HumanoidRootPart
        TargetHumanoid = TargetPlayer.Character:FindFirstChild("Humanoid")
        if not TargetHumanoid then task.wait(0.3) continue end
        local hp = TargetHumanoid.Health
        if hp <= 0 then break end
        faceTarget()
        if hp > 2 then
            for i = 1, 5 do
                if not IsFighting or not ScriptEnabled then break end
                if not TargetHumanoid or not TargetHumanoid.Parent then break end
                if TargetHumanoid.Health <= 2 then break end
                hitTarget()
                task.wait(0.05)
            end
            task.wait(0.1)
        else
            standOnTarget()
            task.wait(0.1)
            stompTarget()
            task.wait(0.1)
            stompTarget()
            task.wait(0.1)
            hitTarget()
            task.wait(0.05)
            hitTarget()
            task.wait(0.2)
            if TargetHumanoid and TargetHumanoid.Parent and TargetHumanoid.Health > 0 then
                standOnTarget()
                stompTarget()
                task.wait(0.1)
                stompTarget()
                task.wait(0.2)
            end
        end
        task.wait(0.05)
    end
    IsFighting = false
end

local function moveToTargetWalk()
    local char, hum, hrp = getChar()
    hum.WalkSpeed = 30
    local startTime = tick()
    while hrp and hrp.Parent and TargetHRP and TargetHRP.Parent and IsFighting do
        local dist = (hrp.Position - TargetHRP.Position).Magnitude
        if dist <= 5 then break end
        if tick() - startTime > 8 then break end
        hum:MoveTo(TargetHRP.Position)
        task.wait(0.1)
    end
    hum:MoveTo(Vector3.zero)
end

local function attackTarget(target)
    IsAtHome = false
    IsFlying = false
    TargetPlayer = target
    IsFighting = true
    updateTargetInfo()
    local char, hum, hrp = getChar()
    local targetPos = target.Character.HumanoidRootPart.Position
    flyToTarget(targetPos, hum, hrp)
    landSafely(targetPos, hum, hrp)
    moveToTargetWalk()
    fightLoop()
    IsFighting = false
    updateTargetInfo()
    goHome()
end

local function mainLoop()
    while ScriptEnabled do
        if IsAtHome and not IsFighting and not IsReturning and not IsFlying then
            local target = scanForTarget()
            if target then
                attackTarget(target)
            end
        end
        task.wait(0.5)
    end
end

RunService.Heartbeat:Connect(function()
    if not ScriptEnabled then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    if NoclipOn and char then enableNoclip(char) end
    if IsFlying and UndergroundY then
        if math.abs(hrp.Position.Y - UndergroundY) > 2 then
            hrp.CFrame = CFrame.new(hrp.Position.X, UndergroundY, hrp.Position.Z)
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
        end
    end
end)

player.CharacterAdded:Connect(function(char)
    task.wait(1)
    if ScriptEnabled then
        TargetPlayer = nil
        TargetHRP = nil
        TargetHumanoid = nil
        IsFighting = false
        IsReturning = false
        IsAtHome = false
        IsFlying = false
        UndergroundY = nil
        goHome()
    end
end)


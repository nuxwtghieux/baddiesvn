local p = P.LocalPlayer
local E = S:WaitForChild("Event")
local FIX = Vector3.new(563.2, 3.9, -20.8)
local RAD = 50

local act, stb, atk, noc, Y, En, Tar = false, false, false, false, nil, false, nil

local function get()
    local char = p.Character or p.CharacterAdded:Wait()
    return char, char:WaitForChild("Humanoid", 5), char:WaitForChild("HumanoidRootPart", 5)
end

local function setNoc(char, state)
    noc = state
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = not state end
    end
end

R.Heartbeat:Connect(function()
    if not En or not act then return end 
    local c = get()
    if noc and c then setNoc(c, true) end 
end)

local function fly(tg)
    if not act then return end 
    stb, En = false, true 
    local c, h, r = get()
    if not r or not h then return end
    
    Y = tg.Y - 12 
    setNoc(c, true)
    h.PlatformStand = true
    workspace.Gravity = 0
    
    r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
    r.Velocity = Vector3.zero
    task.wait(0.1)
    
    while act and r and r.Parent and En do
        local cu = Vector3.new(r.Position.X, Y, r.Position.Z)
        local tu = Vector3.new(tg.X, Y, tg.Z)
        if (cu - tu).Magnitude <= 4 then break end
        r.Velocity = (tu - cu).Unit * 400
        task.wait()
    end
    
    local upY = tg.Y + 3
    while act and r and r.Parent and En do
        if r.Position.Y >= upY then break end
        r.Velocity = Vector3.new(0, 50, 0)
        task.wait()
    end
    
    En = false
    if r then r.Velocity = Vector3.zero r.CFrame = CFrame.new(tg) r.Anchored = true end
    task.wait(0.15) 
    
    if r then r.Anchored = false end 
    if h then h.PlatformStand = false h.AutoRotate = true h.WalkSpeed = 32 end
    workspace.Gravity = 196.2
    setNoc(c, false)
    stb = true
end

local function checkZone()
    if not act or not stb or not Tar or not Tar.Character then return false end 
    local tr = Tar.Character:FindFirstChild("HumanoidRootPart")
    local th = Tar.Character:FindFirstChild("Humanoid")
    if tr and th and th.Health > 0 then 
        return (FIX - tr.Position).Magnitude <= RAD 
    end 
    return false 
end

task.spawn(function()
    while true do 
        task.wait(0.02)
        if act and stb and checkZone() then 
            local c, h, r = get()
            local tc = Tar.Character
            local tr = tc and tc:FindFirstChild("HumanoidRootPart")
            local th = tc and tc:FindFirstChild("Humanoid")
            
            if r and h and tr and th and th.Health > 0 then 
                h.WalkSpeed = 32
                atk = true 
                
                local targetHeightPos = Vector3.new(tr.Position.X, tr.Position.Y + 2.5, tr.Position.Z)
                r.CFrame = CFrame.lookAt(targetHeightPos, tr.Position)
                
                if th.Health > 2 then 
                    local args = {[1] = {["Event"] = "Hit", ["ClientHitbox"] = {}}}
                    E:FireServer(unpack(args))
                else 
                    E:FireServer(unpack({[1] = {["Event"] = "Stomp"}}))
                    E:FireServer(unpack({[1] = {["Event"] = "Stomp"}}))
                    E:FireServer(unpack({[1] = {["Event"] = "Hit", ["ClientHitbox"] = {}}}))
                    E:FireServer(unpack({[1] = {["Event"] = "Hit", ["ClientHitbox"] = {}}}))
                end 
            end
        else 
            if atk or not act then 
                atk = false 
                local _, h, _ = get()
                if h and act then h.WalkSpeed = 32 h:MoveTo(FIX) end 
            end 
        end 
    end 
end)


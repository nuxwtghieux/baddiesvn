        IsAtHome = false
        IsFlying = false
        LandedOnce = false
        UndergroundY = nil
        task.spawn(function()
            goHome()
            while ScriptEnabled do
                if IsAtHome and LandedOnce and not IsFlying then
                    local char = player.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.Anchored = true
                            hrp.Velocity = Vector3.zero
                            hrp.CFrame = CFrame.new(HOME_POS.X, HOME_POS.Y, HOME_POS.Z)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

local FIX = Vector3.new(563.2, 3.9, -20.8)
local FIX_STAND = Vector3.new(FIX.X + 3, FIX.Y, FIX.Z)
local RAD = 50
local FLY_SPEED = 200
local HEAD_OFFSET = 8
local MAX_SPEED = 18
local STUCK_TIMEOUT = 10

local act = false
local stb = false
local noc = false
local Y = nil
local En = false

local function get()
    local c = player.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function enableNoclip(c)
    noc = true
    if not c then return end
    for _, v in pairs(c:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
end

local function disableNoclip(c)
    noc = false
    if not c then return end
    for _, v in pairs(c:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = true end
    end
end

local function enableFreefall(h)
    h.PlatformStand = true
    workspace.Gravity = 0
end

local function disableFreefall(h, r)
    h.PlatformStand = false
    h.AutoRotate = true
    workspace.Gravity = 196.2
    if r then r.Velocity = Vector3.zero end
    h.WalkSpeed = MAX_SPEED
end

local function flyToFix()
    if not act then return end
    stb = false
    En = true
    local c, h, r = get()
    if not r or not h then return end
    local tg = FIX_STAND
    Y = tg.Y - HEAD_OFFSET
    enableFreefall(h)
    enableNoclip(c)
    r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
    r.Velocity = Vector3.zero
    local lastPos = r.Position
    local stuckTime = 0
    while act and En and r and r.Parent do
        local flatCur = Vector3.new(r.Position.X, 0, r.Position.Z)
        local flatTgt = Vector3.new(tg.X, 0, tg.Z)
        local dist = (flatCur - flatTgt).Magnitude
        if dist <= 5 then break end
        local dir = (flatTgt - flatCur).Unit
        r.Velocity = Vector3.new(dir.X * FLY_SPEED, 0, dir.Z * FLY_SPEED)
        if math.abs(r.Position.Y - Y) > 0.5 then
            r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
        end
        h.AutoRotate = false
        if dir.Magnitude > 0.01 then
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(r.Position.X + dir.X, r.Position.Y, r.Position.Z + dir.Z))
        end
        if (r.Position - lastPos).Magnitude < 0.5 then
            stuckTime = stuckTime + 0.1
            if stuckTime >= STUCK_TIMEOUT then
                break
            end
        else
            stuckTime = 0
        end
        lastPos = r.Position
        task.wait()
    end
    En = false
    r.Velocity = Vector3.zero
    if r and r.Parent then
        disableFreefall(h, r)
        task.wait(0.1)
        local startY = r.Position.Y
        local targetY = tg.Y
        for t = 0, 1, 0.05 do
            if not act or not r or not r.Parent then break end
            local newY = startY + (targetY - startY) * t
            r.CFrame = CFrame.new(r.Position.X, newY, r.Position.Z)
            r.Velocity = Vector3.zero
            task.wait(0.02)
        end
        r.CFrame = CFrame.new(tg.X, tg.Y, tg.Z)
        r.Velocity = Vector3.zero
        task.wait(0.2)
    end
    disableNoclip(c)
    h.WalkSpeed = MAX_SPEED
    Y = nil
    stb = true
end

player.CharacterAdded:Connect(function()
    if act then
        task.wait(1)
        flyToFix()
    end
end)


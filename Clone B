--code số 30b: CLONE B - FIX VĂNG KHI TỚI NƠI + TẮT HẲN NOCLIP KHI ĐẾN ĐÍCH
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

local FIX = Vector3.new(563.2, 3.9, -20.8)
local FIX_STAND = Vector3.new(FIX.X + 3, FIX.Y, FIX.Z)
local RAD = 50
local FLY_SPEED = 400
local HEAD_OFFSET = 8
local MAX_SPEED = 18
local STUCK_TIMEOUT = 10

local act = false
local stb = false
local noc = false
local Y = nil
local En = false

local function get()
    local c = player.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function enableNoclip(c)
    noc = true
    if not c then return end
    for _, v in pairs(c:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
end

local function disableNoclip(c)
    noc = false
    if not c then return end
    for _, v in pairs(c:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = true end
    end
end

-- Hàm chống Ragdoll để nhân vật không bị quái đánh té ngã ngửa
local function applyAntiRagdoll(h)
    if not h then return end
    h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    h:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
end

local function enableFreefall(h)
    h.PlatformStand = true
    workspace.Gravity = 0
end

local function disableFreefall(h, r)
    h.PlatformStand = false
    h.AutoRotate = true
    workspace.Gravity = 196.2
    if r then r.Velocity = Vector3.zero end
    h.WalkSpeed = MAX_SPEED
end

local function flyToFix()
    if not act then return end
    stb = false
    En = true -- Bắt đầu trạng thái bay
    local c, h, r = get()
    if not r or not h then return end
    
    applyAntiRagdoll(h)
    local tg = FIX_STAND
    Y = tg.Y - HEAD_OFFSET
    enableFreefall(h)
    enableNoclip(c) -- BẬT NOCLIP KHI BAY
    
    r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
    r.Velocity = Vector3.zero
    r.Anchored = true
    task.wait(0.1)
    r.Anchored = false
    
    local lastPos = r.Position
    local stuckCount = 0
    
    while act and En and r and r.Parent do
        local flatCur = Vector3.new(r.Position.X, 0, r.Position.Z)
        local flatTgt = Vector3.new(tg.X, 0, tg.Z)
        local dist = (flatCur - flatTgt).Magnitude
        if dist <= 5 then break end
        
        local dir = (flatTgt - flatCur).Unit
        r.Velocity = Vector3.new(dir.X * FLY_SPEED, 0, dir.Z * FLY_SPEED)
        
        if math.abs(r.Position.Y - Y) > 0.5 then
            r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
        end
        
        h.AutoRotate = false
        if dir.Magnitude > 0.01 then
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(r.Position.X + dir.X, r.Position.Y, r.Position.Z + dir.Z))
        end
        
        if (r.Position - lastPos).Magnitude < 0.5 then
            stuckCount = stuckCount + 1
            if stuckCount >= 15 then
                r.CFrame = CFrame.new(r.Position.X, Y, r.Position.Z)
                r.Velocity = Vector3.zero
                stuckCount = 0
            end
        else
            stuckCount = 0
        end
        
        lastPos = r.Position
        task.wait()
    end
    
    En = false -- KẾT THÚC BAY
    r.Velocity = Vector3.zero
    
    -- KHÓA VỊ TRÍ TRƯỚC KHI TRỒI LÊN
    if r and r.Parent then
        r.Anchored = true
        task.wait(0.05)
        
        local targetY = tg.Y
        local startY = r.Position.Y
        
        for t = 0, 1, 0.02 do
            if not act or not r or not r.Parent then break end
            local newY = startY + (targetY - startY) * t
            r.CFrame = CFrame.new(r.Position.X, newY, r.Position.Z)
            task.wait(0.02)
        end
        
        r.CFrame = CFrame.new(tg.X, tg.Y, tg.Z)
        r.Anchored = false
        r.Velocity = Vector3.zero
        task.wait(0.1)
    end
    
    if r and r.Parent then
        disableFreefall(h, r)
    end
    disableNoclip(c) -- TẮT HẲN NOCLIP KHI ĐÃ ĐẾN NƠI
    h.WalkSpeed = MAX_SPEED
    Y = nil
    stb = true
end

-- VÒNG LẶP CHỈ LÀM NHIỆM VỤ CHỐNG RAGDOLL + AN TOÀN VOID (BỎ HOÀN TOÀN BẬT NOCLIP LẠI)
task.spawn(function()
    while true do
        task.wait(0.1)
        if act then
            local c, h, r = get()
            if c and r and h then
                applyAntiRagdoll(h) -- Luôn giữ nhân vật đứng thẳng chống ragdoll khi bị quái văng skill
                
                if En then
                    enableNoclip(c) -- Chỉ Noclip khi đang bay
                else
                    disableNoclip(c) -- Đến nơi là tắt sạch Noclip, ép nhân vật có va chạm vật lý với sàn
                    
                    -- PHÒNG THỦ KHẨN CẤP: Nếu chẳng may bị đẩy lọt xuống sàn, kéo giật lại ngay lập tức
                    if r.Position.Y < (FIX_STAND.Y - 4) then
                        r.Velocity = Vector3.zero
                        r.CFrame = CFrame.new(FIX_STAND.X, FIX_STAND.Y, FIX_STAND.Z)
                    end
                end
            end
        else
            local c = player.Character
            if c then disableNoclip(c) end
        end
    end
end)

player.CharacterAdded:Connect(function()
    if act then
        task.wait(1)
        flyToFix()
    end
end)


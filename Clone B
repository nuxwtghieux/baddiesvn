local toa_do_goc = Vector3.new(563.2, 3.9, -20.8)
local toa_do_dung = toa_do_goc + Vector3.new(3, 0, 0)
local do_sau = toa_do_dung.Y - 10
local toc_do_bay = 200
local toc_do_chinh = 20
local toc_do_len = 60
local thoi_gian_ket = 999999
local ban_kinh_vung = 50
local toc_do_chay = 18

local dang_hoat_dong, dang_bay, dang_xuyen, do_cao_bay = false, false, false, nil
local ket_noi_xuyen = nil
local dang_di_ve = false
local da_dap_xong = false

local function lay_nhan_vat()
    local c = nguoi_choi.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function bat_xuyen()
    if ket_noi_xuyen then ket_noi_xuyen:Disconnect() end
    dang_xuyen = true
    ket_noi_xuyen = RunService.Stepped:Connect(function()
        local c = nguoi_choi.Character
        if c and dang_xuyen then
            for _, v in pairs(c:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end

local function tat_xuyen()
    dang_xuyen = false
    if ket_noi_xuyen then
        ket_noi_xuyen:Disconnect()
        ket_noi_xuyen = nil
    end
end

local function bat_roi_tu_do(h)
    h.PlatformStand = true
    workspace.Gravity = 0
end

local function tat_roi_tu_do(h)
    h.PlatformStand = false
    h.AutoRotate = true
    workspace.Gravity = 196.2
    h.WalkSpeed = 0
    h.JumpPower = 0
end

local function di_bo_ve_vung()
    if not dang_hoat_dong or dang_di_ve then return end
    dang_di_ve = true
    local _, h, r = lay_nhan_vat()
    if not h or not r then dang_di_ve = false return end
    h.WalkSpeed = toc_do_chay
    h.JumpPower = 50
    h.AutoRotate = true
    while dang_hoat_dong and dang_di_ve and r and r.Parent do
        local khoang_cach = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(toa_do_dung.X, 0, toa_do_dung.Z)).Magnitude
        if khoang_cach <= 3 then break end
        local huong = (Vector3.new(toa_do_dung.X, 0, toa_do_dung.Z) - Vector3.new(r.Position.X, 0, r.Position.Z)).Unit
        h:MoveTo(toa_do_dung)
        task.wait(0.05)
    end
    dang_di_ve = false
    h.WalkSpeed = 0
    h.JumpPower = 0
    da_dap_xong = true
end

local function bay_toi_vi_tri()
    if not dang_hoat_dong then return end
    dang_bay = true
    da_dap_xong = false
    local c, h, r = lay_nhan_vat()
    if not r or not h then dang_bay = false return end
    bat_xuyen()
    do_cao_bay = do_sau
    bat_roi_tu_do(h)
    r.Velocity = Vector3.new(0, -500, 0)
    while dang_hoat_dong and r and r.Parent and r.Position.Y > do_cao_bay + 1 do task.wait(0.01) end
    r.Velocity = Vector3.zero
    while dang_hoat_dong and dang_bay and r and r.Parent do
        local phang_hien_tai = Vector3.new(r.Position.X, 0, r.Position.Z)
        local phang_dich = Vector3.new(toa_do_dung.X, 0, toa_do_dung.Z)
        if (phang_hien_tai - phang_dich).Magnitude <= 5 then break end
        local huong = (phang_dich - phang_hien_tai).Unit
        r.Velocity = Vector3.new(huong.X * toc_do_bay, 0, huong.Z * toc_do_bay)
        if math.abs(r.Position.Y - do_cao_bay) > 0.5 then
            r.CFrame = CFrame.new(r.Position.X, do_cao_bay, r.Position.Z)
        end
        h.AutoRotate = false
        if huong.Magnitude > 0.01 then
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(r.Position.X + huong.X, r.Position.Y, r.Position.Z + huong.Z))
        end
        task.wait()
    end
    dang_bay = false
    r.Velocity = Vector3.zero
    if r and r.Parent then
        tat_roi_tu_do(h)
        task.wait(0.1)
        local do_cao_hien_tai = r.Position.Y
        local do_cao_dich = toa_do_dung.Y
        for t = 0, 1, 0.03 do
            if not dang_hoat_dong or not r or not r.Parent then break end
            local do_cao_moi = do_cao_hien_tai + (do_cao_dich - do_cao_hien_tai) * t
            r.CFrame = CFrame.new(r.Position.X, do_cao_moi, r.Position.Z)
            r.Velocity = Vector3.zero
            task.wait(0.02)
        end
        local phang_hien_tai = Vector3.new(r.Position.X, 0, r.Position.Z)
        local phang_dich = Vector3.new(toa_do_dung.X, 0, toa_do_dung.Z)
        if (phang_hien_tai - phang_dich).Magnitude > 0.5 then
            local huong = (phang_dich - phang_hien_tai).Unit
            for t = 0, 1, 0.05 do
                if not dang_hoat_dong or not r or not r.Parent then break end
                local phang_moi = phang_hien_tai + (phang_dich - phang_hien_tai) * t
                r.CFrame = CFrame.new(phang_moi.X, toa_do_dung.Y, phang_moi.Z)
                r.Velocity = Vector3.zero
                task.wait(0.02)
            end
        end
        r.CFrame = CFrame.new(toa_do_dung.X, toa_do_dung.Y, toa_do_dung.Z)
        r.Velocity = Vector3.zero
    end
    tat_xuyen()
    if h then
        h.WalkSpeed = 0
        h.JumpPower = 0
        h.AutoRotate = true
    end
    do_cao_bay = nil
    da_dap_xong = true
end

task.spawn(function()
    while task.wait(0.5) do
        if dang_hoat_dong and not dang_bay and not dang_di_ve and da_dap_xong then
            local _, _, r = lay_nhan_vat()
            if r and r.Parent then
                local khoang_cach = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(toa_do_dung.X, 0, toa_do_dung.Z)).Magnitude
                if khoang_cach > ban_kinh_vung then
                    task.spawn(function() di_bo_ve_vung() end)
                end
            end
        end
    end
end)


local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local FLY_SPEED = 400 
local FIXED_POS = Vector3.new(563.2, 3.9, -20.8)
local act = false
local En = false
local noc = false

local function getChar()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    return char, hum, hrp
end

local function setNoc(char, state)
    noc = state
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = not state end
    end
end

-- GHIM NOCLIP LIÊN TỤC CHO CLONE B CHỐNG KẸT KHI NHÔ LÊN NỀN ĐẤT
RunService.Heartbeat:Connect(function()
    if not En or not act then return end 
    local c, _, _ = getChar()
    if noc and c then 
        setNoc(c, true)
    end 
end)

local function executeFly(tg)
    act = true
    En = true
    local c, h, r = getChar()
    if not r or not h then return end
    
    local undergroundY = tg.Y - 12 
    h.PlatformStand = true
    workspace.Gravity = 0
    setNoc(c, true)
    
    r.CFrame = CFrame.new(r.Position.X, undergroundY, r.Position.Z)
    r.Velocity = Vector3.zero
    task.wait(0.1)
    
    -- Giai đoạn 1: Bay dưới đất đến tọa độ đích
    while act and r and r.Parent and En do
        local currentUndergroundPos = Vector3.new(r.Position.X, undergroundY, r.Position.Z)
        local targetUndergroundPos = Vector3.new(tg.X, undergroundY, tg.Z)
        local d = (currentUndergroundPos - targetUndergroundPos).Magnitude 
        
        if d <= 4 then break end
        
        local direction = (targetUndergroundPos - currentUndergroundPos).Unit
        r.Velocity = Vector3.new(direction.X * FLY_SPEED, 0, direction.Z * FLY_SPEED)
        task.wait()
    end
    
    -- Giai đoạn 2: Trồi thẳng đứng lên khỏi mặt đất mượt mà
    local upTargetY = tg.Y + 3
    while act and r and r.Parent and En do
        if r.Position.Y >= upTargetY then break end
        r.Velocity = Vector3.new(0, 50, 0)
        task.wait()
    end
    
    En = false
    act = false
    
    -- Giai đoạn 3: Khóa đứng im thăng bằng tiếp đất an toàn
    if r then 
        r.Velocity = Vector3.zero
        r.CFrame = CFrame.new(tg)
        r.Anchored = true 
    end
    task.wait(0.15) 
    
    if r then r.Anchored = false end 
    h.PlatformStand = false
    workspace.Gravity = 196.2
    setNoc(c, false) -- Rụng xuống đất xong xuôi mới bật lại va chạm cứng
end

player.CharacterAdded:Connect(function()
    if btn and btn.Text == "🛑 SYSTEM ACTIVE" then
        task.wait(1)
        executeFly(FIXED_POS)
    end
end)

if CoreGui:FindFirstChild("EX_B_GUI") then CoreGui["EX_B_GUI"]:Destroy() end

local FIX = Vector3.new(563.2, 3.9, -20.8)
local FIX_STAND = FIX + Vector3.new(3, 0, 0)
local UNDERGROUND_Y = FIX_STAND.Y - 10
local FLY_SPEED = 200
local STUCK_TIMEOUT = 10

local act, En, noc = false, false, false
local noclipConnection = nil

local function getChar()
    local c = player.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function enableNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    noc = true
    noclipConnection = RunService.Stepped:Connect(function()
        local c = player.Character
        if c and noc then
            for _, v in pairs(c:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
end

local function disableNoclip()
    noc = false
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

local function flyUnderground()
    if not act then return end
    En = true
    local c, h, r = getChar()
    if not r or not h then return end
    enableNoclip()
    h.PlatformStand = true
    workspace.Gravity = 0
    r.CFrame = CFrame.new(r.Position.X, UNDERGROUND_Y, r.Position.Z)
    r.Velocity = Vector3.zero
    local lastPos = r.Position
    local stuckTime = 0
    while act and En and r and r.Parent do
        local flatCur = Vector3.new(r.Position.X, 0, r.Position.Z)
        local flatTgt = Vector3.new(FIX_STAND.X, 0, FIX_STAND.Z)
        if (flatCur - flatTgt).Magnitude <= 3 then break end
        local dir = (flatTgt - flatCur).Unit
        r.Velocity = Vector3.new(dir.X * FLY_SPEED, 0, dir.Z * FLY_SPEED)
        if math.abs(r.Position.Y - UNDERGROUND_Y) > 1 then
            r.CFrame = CFrame.new(r.Position.X, UNDERGROUND_Y, r.Position.Z)
        end
        h.AutoRotate = false
        if dir.Magnitude > 0.01 then
            r.CFrame = CFrame.lookAt(r.Position, Vector3.new(r.Position.X + dir.X, r.Position.Y, r.Position.Z + dir.Z))
        end
        if (r.Position - lastPos).Magnitude < 0.5 then
            stuckTime = stuckTime + 0.1
            if stuckTime >= STUCK_TIMEOUT then break end
        else
            stuckTime = 0
        end
        lastPos = r.Position
        task.wait()
    end
    En = false
    r.Velocity = Vector3.zero
    if r and r.Parent then
        local startY = r.Position.Y
        local targetY = FIX_STAND.Y
        for t = 0, 1, 0.05 do
            if not act or not r or not r.Parent then break end
            local newY = startY + (targetY - startY) * t
            r.CFrame = CFrame.new(r.Position.X, newY, r.Position.Z)
            r.Velocity = Vector3.zero
            task.wait(0.02)
        end
        r.CFrame = CFrame.new(FIX_STAND.X, FIX_STAND.Y, FIX_STAND.Z)
        r.Velocity = Vector3.zero
        task.wait(0.3)
    end
    h.PlatformStand = false
    h.AutoRotate = true
    workspace.Gravity = 196.2
    disableNoclip()
    if h then h.WalkSpeed = 0 end
end


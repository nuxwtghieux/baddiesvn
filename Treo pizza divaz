--[[
    AUTO PIZZA DELIVERY + UNDERGROUND (DƯỚI LÒNG ĐẤT)
    - FIX: Không chờ CollectDollar, chỉ spam CompleteJob
    - Kiểm tra tiền xuất hiện trong workspace
--]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

pcall(function()
	local old = PlayerGui:FindFirstChild("ATM_FARM_GUI")
	if old then old:Destroy() end
end)

local Remote = ReplicatedStorage:WaitForChild("Event")
local Enabled = false
local SPEED = 30
local FLY_SPEED = 200
local StartTime = 0
local TotalTime = 0
local NoclipOn = true
local HEAD_OFFSET = 3
local UndergroundY = nil
local IsBusy = false

local TotalMoneyCollected = 0
local CollectedMoneyList = {}

local function getChar()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local hrp = char:WaitForChild("HumanoidRootPart")
	return char, hum, hrp
end

local function enableNoclip(char)
	NoclipOn = true
	for _, v in pairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CanCollide = false
		end
	end
end

local function disableNoclip(char)
	NoclipOn = false
	for _, v in pairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			v.CanCollide = true
		end
	end
end

local function enableFreefall(hum)
	hum.PlatformStand = true
	workspace.Gravity = 0
end

local function disableFreefall(hum, hrp)
	hum.PlatformStand = false
	hum.AutoRotate = true
	workspace.Gravity = 196.2
	if hrp then
		hrp.Velocity = Vector3.zero
	end
	hum.WalkSpeed = SPEED
end

local function antiStuck(hrp)
	hrp.Velocity = Vector3.new(150, 0, 0)
	task.wait(0.2)
	hrp.Velocity = Vector3.new(-150, 0, 0)
	task.wait(0.2)
	hrp.Velocity = Vector3.new(0, 0, 150)
	task.wait(0.2)
	hrp.Velocity = Vector3.new(0, 0, -150)
	task.wait(0.2)
	hrp.Velocity = Vector3.zero
end

-- Lấy tiền mới xuất hiện trong workspace
local function getNewMoney()
	local newMoney = {}
	for _, v in pairs(workspace:GetDescendants()) do
		-- Nhận dạng tiền: MeshPart có tên dài (thường là ID)
		if v:IsA("MeshPart") and #v.Name > 15 then
			if not CollectedMoneyList[v.Name] then
				table.insert(newMoney, v)
			end
		end
	end
	return newMoney
end

-- Thu thập tiền (KHÔNG CHỜ remote)
local function collectMoney(money)
	pcall(function()
		local args = {
			[1] = {
				["Event"] = "CollectDollar",
				["Dollar"] = money
			}
		}
		Remote:FireServer(unpack(args))
		CollectedMoneyList[money.Name] = true
		TotalMoneyCollected = TotalMoneyCollected + 1
	end)
end

local function collectAllNewMoney()
	for _, money in pairs(getNewMoney()) do
		collectMoney(money)
	end
end

local function calculateUndergroundY(zoneY)
	return zoneY - HEAD_OFFSET
end

local function flyToTarget(targetPos, hum, hrp)
	local startTime = tick()
	local lastPos = hrp.Position
	local stuckTime = 0
	
	if not hum.PlatformStand then
		enableFreefall(hum)
	end
	
	if UndergroundY then
		hrp.CFrame = CFrame.new(hrp.Position.X, UndergroundY, hrp.Position.Z)
		hrp.Velocity = Vector3.zero
	end
	
	while Enabled and hrp and hrp.Parent and tick() - startTime < 15 do
		local currentPos = hrp.Position
		local flatCurrent = Vector3.new(currentPos.X, 0, currentPos.Z)
		local flatTarget = Vector3.new(targetPos.X, 0, targetPos.Z)
		local dist = (flatCurrent - flatTarget).Magnitude
		
		if dist <= 1.5 then break end
		
		local direction = (flatTarget - flatCurrent).Unit
		
		hrp.Velocity = Vector3.new(
			direction.X * FLY_SPEED,
			0,
			direction.Z * FLY_SPEED
		)
		
		if math.abs(hrp.Position.Y - UndergroundY) > 0.5 then
			hrp.CFrame = CFrame.new(hrp.Position.X, UndergroundY, hrp.Position.Z)
			hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
		end
		
		hum.AutoRotate = false
		if direction.Magnitude > 0.01 then
			hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(
				hrp.Position.X + direction.X,
				hrp.Position.Y,
				hrp.Position.Z + direction.Z
			))
		end
		
		if (hrp.Position - lastPos).Magnitude < 0.5 then
			stuckTime = stuckTime + 0.1
			if stuckTime >= 2 then
				antiStuck(hrp)
				stuckTime = 0
			end
		else
			stuckTime = 0
		end
		lastPos = hrp.Position
		
		task.wait()
	end
	
	hrp.Velocity = Vector3.zero
	
	if hrp and hrp.Parent and UndergroundY then
		hrp.CFrame = CFrame.new(targetPos.X, UndergroundY, targetPos.Z)
		hrp.Velocity = Vector3.zero
	end
end

local function triggerDelivery(prompt, hrp)
	if hrp and hrp.Parent then
		hrp.Velocity = Vector3.zero
	end
	
	pcall(function()
		prompt:InputHoldBegin()
		task.wait(0.15)
		prompt:InputHoldEnd()
	end)
end

local function findDelivery()
	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("ProximityPrompt") and v.ActionText == "Deliver" then
			return v
		end
	end
	return nil
end

local function startJob()
	pcall(function()
		Remote:FireServer({["Event"] = "StartJob", ["Job"] = "Pizza"})
	end)
end

local function completeJob()
	pcall(function()
		Remote:FireServer({["Event"] = "CompletedJob", ["Job"] = "Pizza"})
	end)
end

function farm()
	while Enabled do
		if IsBusy then 
			task.wait(0.3)
			continue 
		end
		IsBusy = true
		
		-- Kiểm tra character
		if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
			task.wait(1)
			IsBusy = false
			continue
		end
		
		-- StartJob
		startJob()
		task.wait(0.5)
		
		-- Tìm delivery prompt (timeout 5 giây)
		local prompt = nil
		local findStart = tick()
		repeat
			if not Enabled then 
				IsBusy = false
				return 
			end
			prompt = findDelivery()
			if prompt then break end
			task.wait(0.2)
		until tick() - findStart > 5
		
		if not prompt then
			IsBusy = false
			task.wait(0.5)
			continue
		end
		
		local char, hum, hrp = getChar()
		if not char or not hum or not hrp then
			IsBusy = false
			task.wait(1)
			continue
		end
		
		local targetPos = prompt.Parent.Position
		
		if not UndergroundY then
			UndergroundY = calculateUndergroundY(targetPos.Y)
		end
		
		enableNoclip(char)
		enableFreefall(hum)
		
		hrp.CFrame = CFrame.new(hrp.Position.X, UndergroundY, hrp.Position.Z)
		hrp.Velocity = Vector3.zero
		
		-- Bay tới target
		flyToTarget(targetPos, hum, hrp)
		
		if Enabled and player.Character and hrp and hrp.Parent then
			-- Deliver
			triggerDelivery(prompt, hrp)
			task.wait(0.3)
			
			-- ===== QUAN TRỌNG: Spam CompleteJob 3 lần, KHÔNG CHỜ AI CẢ =====
			local moneyFound = false
			
			for i = 1, 3 do
				if not Enabled then break end
				
				completeJob()
				task.wait(0.2)
				
				-- Kiểm tra xem tiền đã xuất hiện trong workspace chưa
				local newMoney = getNewMoney()
				if #newMoney > 0 then
					moneyFound = true
					-- Thu thập ngay lập tức
					for _, money in pairs(newMoney) do
						collectMoney(money)
					end
					break
				end
			end
			
			-- Dù có tiền hay không, vẫn StartJob lại để tiếp tục
			if Enabled then
				startJob()
			end
			
			-- Thu thập nốt tiền (nếu có)
			collectAllNewMoney()
			
			-- Nghỉ ngắn trước khi vòng lặp tiếp theo
			task.wait(0.3)
		end
		
		IsBusy = false
		task.wait(0.1)
	end
end

RunService.Heartbeat:Connect(function()
	if not Enabled then return end
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	
	if hum and not hum.PlatformStand then
		if hum.WalkSpeed ~= SPEED then
			hum.WalkSpeed = SPEED
		end
	end
	
	if NoclipOn then
		enableNoclip(char)
	end
	
	if Enabled and hrp and UndergroundY then
		if math.abs(hrp.Position.Y - UndergroundY) > 2 then
			hrp.CFrame = CFrame.new(hrp.Position.X, UndergroundY, hrp.Position.Z)
			hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	task.wait(1)
	if Enabled then
		CollectedMoneyList = {}
		UndergroundY = nil
		IsBusy = false
		task.spawn(function()
			pcall(function() farm() end)
		end)
	end
end)

local function formatTime(seconds)
	local hours = math.floor(seconds / 3600)
	local mins = math.floor((seconds % 3600) / 60)
	local secs = math.floor(seconds % 60)
	return string.format("%02d:%02d:%02d", hours, mins, secs)
end


--// ============ MAIN FARM LOOP ============
function farm()
    while Enabled do
        if IsRestarting then
            task.wait(0.5)
            continue
        end
        
        if IsBusy then task.wait(0.3) continue end
        IsBusy = true
        
        if not isCharacterAlive() then
            IsBusy = false
            restartFarm()
            continue
        end
        
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            task.wait(1)
            IsBusy = false
            continue
        end
        
        forceEquipPizza()
        startJob()
        
        local prompt = nil
        local findStart = tick()
        repeat
            if not Enabled or IsRestarting then IsBusy = false return end
            if not isCharacterAlive() then
                IsBusy = false
                restartFarm()
                return
            end
            prompt = findDelivery()
            if prompt then break end
            task.wait(0.2)
        until tick() - findStart > 5
        
        if not prompt then
            IsBusy = false
            task.wait(0.5)
            continue
        end
        
        local char, hum, hrp = getChar()
        if not char or not hum or not hrp then
            IsBusy = false
            task.wait(1)
            continue
        end
        
        if not isCharacterAlive() then
            IsBusy = false
            restartFarm()
            continue
        end
        
        local targetPos = prompt.Parent.Position
        -- Cập nhật UndergroundY dựa trên vị trí giao hàng
        UndergroundY = calculateUndergroundY(targetPos.Y)
        
        enableNoclip(char)
        enableFreefall(hum)
        hrp.CFrame = CFrame.new(hrp.Position.X, UndergroundY, hrp.Position.Z)
        hrp.Velocity = Vector3.zero
        
        local reached = flyToTarget(targetPos, hum, hrp)
        
        if not isCharacterAlive() then
            IsBusy = false
            restartFarm()
            continue
        end
        
        if not reached then
            IsBusy = false
            pcall(function() Remote:FireServer({["Event"] = "CompletedJob", ["Job"] = "Pizza"}) end)
            task.wait(0.5)
            forceEquipPizza()
            task.wait(0.5)
            continue
        end
        
        if Enabled and player.Character and hrp and hrp.Parent and isCharacterAlive() then
            triggerDelivery(prompt, hrp)
            task.wait(0.3)
            
            for i = 1, 3 do
                if not Enabled or IsRestarting then break end
                if not isCharacterAlive() then break end
                
                completeJobAndForceEquipPizza()
                task.wait(0.2)
                
                local newMoney = getNewMoney()
                if #newMoney > 0 then
                    for _, money in pairs(newMoney) do
                        collectMoney(money)
                    end
                    break
                end
            end
            
            if Enabled and not IsRestarting and isCharacterAlive() then
                startJob()
                forceEquipPizza()
            end
            
            collectAllNewMoney()
            updateEarnedMoney()
            task.wait(0.3)
        end
        
        IsBusy = false
        task.wait(0.1)
    end
end

--// ============ KHỞI ĐỘNG ============
local function startFarm()
    if not Enabled then return end
    
    -- BƯỚC 1: XUỐNG UNDERGROUND TRƯỚC
    goUnderground()
    
    -- BƯỚC 2: SETUP SKI MASK
    setupSkiMask()
    
    -- BƯỚC 3: BẮT ĐẦU FARM
    farm()
end


        StartTime = 0
        local char = player.Character
        if char then
            disableNoclip(char)
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then disableFreefall(hum, hrp) end
        end
    else
        Enabled = true
        button.Text = "⏸ STOP"
        button.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        stroke.Color = Color3.fromRGB(0, 255, 100)
        CollectedMoneyList = {}
        UndergroundY = -HEAD_OFFSET
        IsBusy = false
        isEquipping = false
        IsRestarting = false
        MaskReady = false
        resetMoneyCounter()
        StartTime = os.time()
        task.spawn(startFarm)
    end
end)
